modules = ["vue-node-20", "nodejs-20", "web", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173

[workflows]

[deployment]
deploymentTarget = "static"
build = ["npm", "run", "build"]
publicDir = "dist"
